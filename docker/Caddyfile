# NEXORA — TLS reverse proxy + SPA host (Partition B · deploy prep).
# STATUS: prepared, build/deploy UNVERIFIED — this file was never loaded by
# a running Caddy (no `docker build` / `docker compose up` was executed).
#
# ── Before first boot ──────────────────────────────────────────────────────
# 1. Replace `pos.example.com` with the REAL DNS name (A/AAAA → this host).
#    With a real name Caddy issues a Let's Encrypt certificate by itself —
#    then DELETE the `tls internal` line. `tls internal` is only for the
#    placeholder/lab phase and produces certificates browsers will reject.
# 2. Validate without starting anything:
#      docker compose -f docker/compose.yml config
#      docker compose -f docker/compose.yml run --rm --no-deps \
#        --entrypoint caddy caddy validate \
#        --config /etc/caddy/Caddyfile --adapter caddyfile
# 3. The SPA must already be built on the host: apps/web/dist/index.html
#    (compose bind-mounts ../apps/web/dist → /srv/web).
#
# ── Routing contract (exclusive) ───────────────────────────────────────────
#   /api/*   → api:3000  — the ONLY thing proxied. Auth, settings and every
#                          business payload live under /api/*, so a single
#                          prefix rule cannot leak them into the static tree.
#   everything else → the built SPA in /srv/web (index.html fallback)
#
# The API container's port is not published: this file is the only way in.

pos.example.com {
	encode gzip

	# API first: `handle` blocks are mutually exclusive, so /api/* never
	# falls through to the static handler (and vice versa).
	@api path /api/*
	handle @api {
		# X-Forwarded-For is appended here; the API honours it only when the
		# peer address is inside Docker's private range (trustProxy CIDR in
		# apps/api/src/app.ts), so its rate limit keys on the real client IP.
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web
		# SPA fallback: unknown paths render the shell, /api/* cannot reach
		# this block (handled above).
		try_files {path} /index.html
		file_server

		# P1-7 · hardening for the SPA tree ONLY — /api/* never reaches this
		# block, so business/auth responses are governed by the API itself
		# (apps/api/src/app.ts onSend headers).
		#
		# CSP — every relaxation is deliberate and verified against the code:
		#   · script-src 'wasm-unsafe-eval'  PGlite compiles postgres.wasm on
		#     the MAIN thread (new PGlite(url) from @electric-sql/pglite — the
		#     /worker entry is not used), and wasm compilation is gated by
		#     script-src in Chrome/Firefox. Without it the POS cannot boot.
		#     'wasm-unsafe-eval' does NOT allow JavaScript eval().
		#   · worker-src 'self'             would fall back to default-src
		#     anyway; stated explicitly for the PWA service worker (/sw.js).
		#     NO blob: relaxation: nothing in apps/web/src creates a Worker
		#     (grep "new Worker" → 0 hits) and the CSV export downloads via
		#     an <a download> blob URL, which CSP does not block.
		#   · style-src 'unsafe-inline'     React renders inline style
		#     attributes (style-src-attr inherits from style-src).
		#   · img-src data:                 defensive: product photos are
		#     paths today, no data: image is built by the app.
		#   · connect-src 'self'            every call is same-origin
		#     /api/*; the source tree contains no external origin.
		#   · base-uri/form-action/object-src  hardening, no relaxation: the
		#     app has no <base>, posts nothing off-origin and embeds no
		#     plugin/object.
		#   · frame-ancestors 'none' + X-Frame-Options DENY  belt and braces
		#     (the header is ignored by modern browsers that read CSP).
		#
		# Cache: default for everything served from /srv/web is revalidate;
		# the /assets/* rule below overrides that one field for content-hashed
		# files (same field, later match wins).
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "same-origin"
			Cache-Control "no-cache"
		}
		header /assets/* {
			Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# PLACEHOLDER ONLY — see step 1 above. Real deployments use the
	# automatic HTTPS certificate and drop this line.
	tls internal
}
