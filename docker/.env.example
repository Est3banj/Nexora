# NEXORA — production environment (NAMES ONLY, no values).
#
# Usage:
#   cp docker/.env.example docker/.env
#   $EDITOR docker/.env          # fill every value — nothing here is a secret
#   docker compose --env-file .env config   # dry-run the interpolation
#
# `.env` is git-ignored (root .gitignore: `.env`) and excluded from the
# docker build context (.dockerignore) — it must NEVER be committed.
# Values are referenced by docker/compose.yml; the API also reads
# BETTER_AUTH_* / DATABASE_URL / TRUSTED_ORIGINS from its environment.

# ── Postgres (db service bootstrap + api DATABASE_URL) ──────────────────────
# Alphanumeric user. DB name: lowercase, no dashes.
NEXORA_DB_USER=
NEXORA_DB_PASSWORD=
NEXORA_DB_NAME=

# Full connection string FOR THE API. Must point at the compose network's
# db service and use the SAME user/password/db as above, e.g.
#   postgres://<NEXORA_DB_USER>:<NEXORA_DB_PASSWORD>@db:5432/<NEXORA_DB_NAME>
# If your password contains characters that are special in a URL
# (@ : / # ? [ ]), percent-encode them here (e.g. %40 for @).
NEXORA_DATABASE_URL=

# ── API (apps/api/src/config.ts fails fast when any of these is wrong) ──────
# Generate: openssl rand -base64 32   (>= 32 chars; the dev default is refused)
NEXORA_BETTER_AUTH_SECRET=

# Public https origin of the API itself (scheme + host, no path), e.g.
#   https://pos.example.com
# Must be https and must NOT be localhost/127.0.0.1 in production.
NEXORA_BETTER_AUTH_URL=

# Comma-separated https origins of the WEB app that may call this API, e.g.
#   https://pos.example.com
# No dev origin (http://localhost:5173) is added in production — list them
# all explicitly. Each entry must be https and must NOT be loopback.
NEXORA_TRUSTED_ORIGINS=
