{
  "name": "pos-piloto",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "seed": "pnpm --filter @pos/api seed",
    "db:push": "pnpm --filter @pos/api db:push"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "workbox-build>glob": "14.0.2",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "vitest>vite": "^6.4.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
